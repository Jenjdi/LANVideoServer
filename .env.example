# Export variables in your shell; the application never executes .env files.
LANVIDEO_BIND=127.0.0.1
LANVIDEO_PORT=8080
LANVIDEO_DATA=var
LANVIDEO_LOG_LEVEL=info
# Session lifetime in seconds; accepted range 30..86400 (default 8 hours).
LANVIDEO_SESSION_TTL=28800
# Video uploads: 1..4096 MiB, streaming to disk (default 512 MiB).
LANVIDEO_UPLOAD_MIB=512
# Optional absolute executable path; export LANVIDEO_FFPROBE='' to disable probing.
LANVIDEO_FFPROBE=/usr/bin/ffprobe
# Set to an https:// hostname when deployed behind a TLS reverse proxy.
LANVIDEO_PUBLIC_ORIGIN=
# local (default) or reverse_proxy; reverse_proxy requires 127.0.0.1 and HTTPS origin.
LANVIDEO_REMOTE_MODE=local
# Optional absolute CA bundle for an operator-controlled private HTTPS entry.
# Empty uses system trust; never disable TLS verification.
LANVIDEO_REMOTE_CA=
# Optional absolute asset folder; default installed ../share/lanvideo/web, or source web/.
LANVIDEO_WEB_ROOT=
